{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "declaration": true,
    "noImplicitAny": false
  },
  "include": ["hardhat.config.ts", "deploy/**/*.ts", "test/**/*.ts", "tasks/**/*.ts"],
  "files": []
}
