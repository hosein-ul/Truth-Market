{
  "name": "truthmarket",
  "version": "0.1.0",
  "description": "TruthMarket - Confidential prediction market on Zama FHEVM",
  "license": "BSD-3-Clause-Clear",
  "private": true,
  "scripts": {
    "clean": "rimraf artifacts cache typechain-types coverage coverage.json",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "coverage": "hardhat coverage",
    "deploy:localhost": "hardhat deploy --network localhost",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "verify:sepolia": "hardhat etherscan-verify --network sepolia",
    "chain": "hardhat node --verbose --hostname 0.0.0.0",
    "typechain": "hardhat typechain"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fhevm/mock-utils": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "^0.4.0",
    "@openzeppelin/contracts": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.5",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.14.0",
    "hardhat-gas-reporter": "^2.2.2",
    "mocha": "^11.7.5",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^2.0.0",
    "rimraf": "^6.0.1",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.3"
  }
}
